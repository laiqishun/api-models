  "swagger": "2.0",
  "info": {
    "title": "Creator Generate Publisher Link",
    "version": "202504",
    "description": "You can use this API to generate material sharing links for a specific publisher. After that, you can share the link with the publisher. Right now, the material type must be `PRODUCT`.\nPlease ensure that the material is included in the campaign by using [Generate Multi Affiliate Partner Campaign Product Links](generate-multi-affiliate-partner-campaign-product-links)."
  },
  "host": "open-api.tiktokglobalshop.com",
  "schemes": [
    "https"
  ],
  "basePath": "/",
  "paths": {
    "/affiliate_creator/202504/affiliate_sharing_links/publisher/{publisher_id}/generate_batch": {
      "post": {
        "tags": [
          "affiliate-creator"
        ],
        "operationId": "creator_generate_publisher_link_202504",
        "summary": "Creator Generate Publisher Link",
        "description": "You can use this API to generate material sharing links for a specific publisher. After that, you can share the link with the publisher. Right now, the material type must be `PRODUCT`.\nPlease ensure that the material is included in the campaign by using [Generate Multi Affiliate Partner Campaign Product Links](generate-multi-affiliate-partner-campaign-product-links).",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "content-type",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "Allowed type: application/json",
            "example": "application/json"
          },
          {
            "name": "x-tts-access-token",
            "in": "header",
            "required": true,
            "type": "string",
            "description": "The creator access_token value from [Get Access Token](https://partner.tiktokshop.com/docv2/page/678e3a3292b0f40314a92d75#Get%20Access%20Token%20API), when user_type = 1. Follow this [guide](https://partner.tiktokshop.com/docv2/page/678e3a362dccb8030ea6f98c) to get creator access_token."
          },
          {
            "name": "app_key",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Every single app will have a unique key. Please use the specific key assigned to your app.",
            "example": "38abcd"
          },
          {
            "name": "sign",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Signature generated by gen algorithm. When you send API requests to TTS, you must sign them so that TTS can identify the senders. ",
            "example": "5361235029d141222525e303d742f9e38aea052d10896d3197ab9d6233730b8c"
          },
          {
            "name": "timestamp",
            "in": "query",
            "required": true,
            "type": "integer",
            "description": "Unix timestamp GMT (UTC+00:00). This timestamp is used across all API requests. Developers can use this convert to local time.",
            "example": "1623812664"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Request body. Full source table is retained in x-tiktok-request-body-parameters.",
            "schema": {
              "type": "object",
              "properties": {
                "material": {
                  "type": "object",
                  "properties": {
                    "ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "The list of material IDs. The max length is 50."
                    },
                    "type": {
                      "type": "string",
                      "description": "Right now, the only possible value is `PRODUCT` or `CAMPAIGN`.\nWhen `material_ids==PRODUCT`, use pids for material IDs."
                    },
                    "promotion_campaign_schema": {
                      "type": "string",
                      "description": "When `type` is set to `CAMPAIGN`, this field is required. This schema is associated with the Campaign page."
                    }
                  },
                  "description": "The entities for which the sharing links are generated.",
                  "required": [
                    "ids",
                    "type"
                  ]
                },
                "campaign_id": {
                  "type": "string",
                  "description": "If a creator adds products from a campaign, please include the campaign ID. The campaign ID can be found in the Affiliate Center or retrieved using the Get Affiliate Partner Campaign List API."
