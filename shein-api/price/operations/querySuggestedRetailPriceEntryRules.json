                      "properties": {
                        "is_rrp_required": {
                          "type": "integer",
                          "description": "SKU维度建议零售价是否必填，0-非必填，1-必填",
                          "x-shein-example-redacted": true
                        },
                        "site_filling_rule": {
                          "type": "integer",
                          "description": "是否允许按分站点维度填写，1-允许，0-不允许",
                          "x-shein-example-redacted": true
                        },
                        "available_sites": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "description": "分站点维度规则下，可填写的站点与币种列表。仅在site_filling_rule=1的时候，此字段才会有值。",
                            "properties": {
                              "site": {
                                "type": "string",
                                "description": "站点名，例如shein-fr",
                                "x-shein-example-redacted": true
                              },
                              "currency": {
                                "type": "string",
                                "description": "站点币种，例如EUR",
                                "x-shein-example-redacted": true
                              },
                              "material_requirement": {
                                "type": "integer",
                                "description": "站点对辅助材料类型的要求，0-不需要填材料，1-类型一材料必填（文件必填，链接选填）、类型二材料选填（文件、链接均选填），2-类型一 或 类型二，至少填写一种（不论选哪一种类型，里面的文件、链接至少给一个），3-所有类型均选填",
                                "x-shein-example-redacted": true
                              }
                            }
                          },
                          "x-shein-original-multiple": 1
                        },
                        "non_site_filling_rule": {
                          "type": "integer",
                          "description": "不分站点填写规则，1-可填，0-不可填",
