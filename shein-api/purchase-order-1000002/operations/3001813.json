  "paths": {
    "/open-api/order/get-mothe-child-orders": {
      "get": {
        "tags": [
          "采购单"
        ],
        "operationId": "shein_api_3001813",
        "summary": "JIT母单及子单对应关系查询接口",
        "description": "1.入参orderNos，selectJitMother必填，orderNos最多支持200个订单 2.info是个列表，列表实体必返回请求的订单号，motherOrChildOrders=空列表（不为null）的情况： 1）订单的商家与请求的商家不一致， 2）非JIt订单 3）查询的订单与selectJitMother不一致 实现逻辑：遍历请求订单编号，校验，如果订单是JIt母单 && 请求查询母单 则motherOrChildOrders为对应的子单信息 如果订单是JIt子单 && 请求查询非母单 且 则motherOrChildOrders为对应的母单信息 如果订单是JIt合单 && 请求查询非母单 且 则motherOrChildOrders为对应的母单信息 code=0返回成功，其他为异常，异常信息取msg",
        "responses": {
          "200": {
            "description": "See the official response schema",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "description": "状态码"
                },
                "msg": {
                  "type": "string",
                  "description": "提示信息"
                },
                "info": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "description": "响应信息",
                    "properties": {
                      "orderNo": {
                        "type": "string",
                        "description": "查询订单号"
                      },
                      "motherOrChildOrders": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "description": "如果是JIt母单，则列表存其关联子单；如果是Jit子单或JIt合单，则表存其关联母单，否则为空列表[]",
                          "properties": {
                            "orderNo": {
                              "type": "string",
                              "description": "关联的订单号"
                            },
                            "status": {
                              "type": "string",
                              "description": "订单状态：1待下单（暂时不支持），2已下单，3发货中，4已送货，5已收货，6已查验，7已退货，8已完成，9无货下架，10已作废，11待审核，12分单中 13待退货 14全部触发"
                            },
                            "statusName": {
                              "type": "string",
                              "description": "订单状态：1待下单（暂时不支持），2已下单，3发货中，4已送货，5已收货，6已查验，7已退货，8已完成，9无货下架，10已作废，11待审核，12分单中 13待退货 14全部触发"
                            }
                          }
                        },
                        "x-shein-original-multiple": 1
                      }
                    },
                    "required": [
                      "orderNo",
                      "motherOrChildOrders"
                    ]
                  },
                  "x-shein-original-multiple": 1
                },
                "error": {
                  "type": "string",
                  "description": "错误码"
                },
                "traceId": {
                  "type": "string",
                  "description": "请求的唯一标识；用于异常报错跟踪"
                }
              }
            }
          }
        },
