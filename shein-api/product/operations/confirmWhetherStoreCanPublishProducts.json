  "paths": {
    "/open-api/goods/product/check-publish-permission": {
      "get": {
        "tags": [
          "商品"
        ],
        "operationId": "confirmWhetherStoreCanPublishProducts",
        "summary": "确认店铺是否可发品",
        "description": "发布商品前调用接口 ，确认商家店铺是否有发布商品资格。店铺会因为多种原因导致无法发品，大多需要商家前往商家后台处理，此接口覆盖以下原因： 1、店铺已关闭。即无法运营。 2、店铺当前有禁止发品的违规单，需按平台建议处理。 3、店铺的部分站点KYC未完成，KYC认证后可发品。 4、自运营类型店铺的所有站点发货&退货地址未维护，维护后可发品。 5、自运营/半托管店铺的在架额度为0，全托管店铺的可发品额度为0。 6、店铺无可用的上架站点。",
        "responses": {
          "200": {
            "description": "See the official response schema",
            "schema": {
              "type": "object",
              "description": "OK",
              "x-shein-label": "ResponseOfPublishPermissionResp",
