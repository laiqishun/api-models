                      "description": "店铺是否可发品。 true-可发品；false-不可发品。"
                    },
                    "reason": {
                      "type": "string",
                      "description": "不可发品的原因。只有当 canPublishProduct=false时才有值。"
                    }
                  }
                },
                "msg": {
                  "type": "string",
                  "description": "响应信息,成功：OK"
                }
              },
