    "/open-api/goods/check-deletable": {
      "post": {
        "tags": [
          "商品"
        ],
        "operationId": "productDeletionPreValidation",
        "summary": "商品删除预校验",
        "description": "商品删除操作是SKC维度，SKC需要满足以下所有条件时才能被删除。以下的1、2、3三点可通过此接口校验知晓。4、5需要提交删除申请后以审核结果为准。 1、商家允许操作商品删除，并非所有商家都可删除商品。 2、商家每天最多删除500个SKC，删除时还有额度。 3、SKC已审核通过且没有被删除。 4、SKC不是【已上架】状态，即待上架、已下架、已售罄可删除。（即/open-api/goods/spu-info中，skc的shelfStatusInfoList中所有站点均为非上架状态） 5、SKC无未签收的订单、退货中的订单、无1年内有效订单。",
        "responses": {
          "200": {
            "description": "See the official response schema",
            "schema": {
              "type": "object",
              "description": "OK",
              "x-shein-label": "ResponseOf开放平台-商品删除预校验响应",
              "properties": {
                "code": {
                  "type": "string",
                  "description": "响应编码 成功：0"
                },
                "msg": {
                  "type": "string",
                  "description": "错误描述,成功：OK"
                },
                "info": {
