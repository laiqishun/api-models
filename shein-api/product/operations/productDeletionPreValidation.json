                  "properties": {
                    "deletable_list": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "description": "可删除的SKC编码列表（满足1、2、3条件，条件说明见顶部）"
                      },
                      "x-shein-original-multiple": 1
                    },
                    "undeletable_list": {
                      "type": "array",
                      "items": {
