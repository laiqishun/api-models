        ],
        "operationId": "shein_api_3002025",
        "summary": "查询商家发品额度",
        "description": "商家能否发品的条件之一：发品额度，每个商家每个月会定时更新额度。发品额度指：当前周期内可 累计的发布且审核成功的SKC总数量 。只要SKC审核通过，即使下架或删除都无法恢复发品额度。 建议开发者在提交发品信息前，先查询发品额度（SKC维度），如果本次提交的SKC数超过发品额度，则提醒商家删减SKC。 发品额度管控中存在“品牌豁免”情况，即如果商品是指定品牌的，则商品不计入发品额度，当商家发布品牌商品时，可在入参中加品牌进行查询。",
        "responses": {
          "200": {
            "description": "See the official response schema",
            "schema": {
              "type": "object",
              "description": "OK",
              "x-shein-label": "ResponseOfGetMerchantQuotaResp",
              "properties": {
                "code": {
                  "type": "string",
                  "description": "响应编码 成功：0"
                },
                "msg": {
                  "type": "string",
                  "description": "错误描述,成功：OK"
                },
                "info": {
                  "type": "object",
                  "description": "商家可发品数查询响应",
                  "x-shein-label": "GetMerchantQuotaResp",
                  "properties": {
                    "isControlled": {
                      "type": "boolean",
                      "description": "是否管控发品额度。 部分情况不管控发品额度，若=false，则代表发品SKC数量无限制。若=true，则需要根据下方availableQuota进行判断。",
                      "x-shein-example-redacted": true
                    },
                    "totalQuota": {
                      "type": "integer",
                      "description": "当前周期内发品总额度。isControlled=false时，值为null。"
                    },
                    "availableQuota": {
                      "type": "integer",
                      "description": "剩余可发品数。isControlled=true时，此值必须大于0时才能发品。isControlled=false时，值为null。"
                    },
                    "usedCount": {
                      "type": "integer",
                      "description": "已发品数。isControlled=false时，值为null。"
                    }
                  }
                },
