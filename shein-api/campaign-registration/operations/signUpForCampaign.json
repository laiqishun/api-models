                  {
                    "props": {
                      "type": "integer",
                      "description": "<p><span style=\"font-size: 14px;\">活动件数按SKC维度提报。</span></p><p><span style=\"font-size: 14px;\">先查询活动详情接口，若</span><span style=\"font-size: 14px;\"><code>partakeFieldList</code></span><span style=\"font-size: 14px;\">包含2，则活动件数必传。再通过活动可报商品列表接口获取</span><span style=\"font-size: 14px;\"><code>minActStockNum</code></span><span style=\"font-size: 14px;\">、</span><span style=\"font-size: 14px;\"><code>maxActStockNum</code></span><span style=\"font-size: 14px;\">和</span><span style=\"font-size: 14px;\"><code>stock</code></span><span style=\"font-size: 14px;\">，活动件数需在</span><span style=\"font-size: 14px;\"><code>minActStockNum</code></span><span style=\"font-size: 14px;\">和</span><span style=\"font-size: 14px;\"><code>maxActStockNum</code></span><span style=\"font-size: 14px;\">区间内，且不大于</span><span style=\"font-size: 14px;\"><code>stock</code></span><span style=\"font-size: 14px;\">。</span></p>",
                      "name": "actStock"
                    }
                  },
                  {
                    "props": {
                      "type": "integer",
                      "description": "<p><span style=\"font-size: 14px;\">活动预留件数按SKC维度提报。</span></p><p><span style=\"font-size: 14px;\">先查询活动详情接口，若</span><span style=\"font-size: 14px;\"><code>partakeFieldList</code></span><span style=\"font-size: 14px;\">包含3，则活动预留件数必传。再通过活动可报商品列表接口获取</span><span style=\"font-size: 14px;\"><code>minReserveStockNum</code></span><span style=\"font-size: 14px;\">和</span><span style=\"font-size: 14px;\"><code>stock</code></span><span style=\"font-size: 14px;\">，活动预留件数需不小于</span><span style=\"font-size: 14px;\"><code>minReserveStockNum</code></span><span style=\"font-size: 14px;\">，且不大于</span><span style=\"font-size: 14px;\"><code>stock</code></span><span style=\"font-size: 14px;\">。</span></p>",
                      "name": "reserveStock"
                    }
                  },
                  {
                    "props": {
                      "type": "object",
                      "description": "<p><span style=\"font-size: 14px;\">半托管/全托管模式下，若活动详情接口返回</span><span style=\"font-size: 14px;\"><code>partakeScope=0</code></span><span style=\"font-size: 14px;\">，则需通过本字段按SKC维度提报活动价格。</span></p>",
                      "name": "supplyPriceInfo"
                    },
                    "children": [
                      {
                        "props": {
                          "type": "string",
                          "multiple": 1,
                          "description": "<p><span style=\"font-size: 14px;\">站点，示例：shein-br。</span></p><p><span style=\"font-size: 14px;\">先查询活动详情接口：当</span><span style=\"font-size: 14px;\"><code>supportSelectSitePartake=1</code></span><span style=\"font-size: 14px;\">时，本字段必传，且取值必须来自接口返回的</span><span style=\"font-size: 14px;\"><code>siteList</code></span><span style=\"font-size: 14px;\">；当</span><span style=\"font-size: 14px;\"><code>supportSelectSitePartake=0</code></span><span style=\"font-size: 14px;\">时，无需传入本字段。</span></p>",
