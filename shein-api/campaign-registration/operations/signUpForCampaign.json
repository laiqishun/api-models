                              "name": "siteList"
                            }
                          },
                          {
                            "props": {
                              "type": "string",
                              "description": "<p style=\"text-align: start;\">半托管/全托管模式下的供货价币种，示例：BRL。</p><p style=\"text-align: start;\">取值可通过查询活动详情接口返回的<code>supplyPriceCurrency</code>获取。</p>",
                              "name": "enrollCurrency",
                              "required": true
                            }
                          },
                          {
                            "props": {
                              "type": "string",
                              "description": "<p style=\"text-align: start;\">按SKU维度提报活动供货价，计算公式为：活动供货价=供货价*（1-供货价降幅）。</p><p style=\"text-align: start;\">其中，SKU供货价可通过查询活动可报商品列表接口获取。供货价降幅需参考该接口返回的<code>minSupplyPriceRate</code>、<code>maxSupplyPriceRate</code>、<code>minVipSupplyPriceRate</code>、<code>maxVipSupplyPriceRate</code>、<code>minSvipSupplyPriceRate</code>等字段，可从支持的降幅档位中任选其一进行提报。</p><p style=\"text-align: start;\">通常支持填写至小数点后两位；若供货价币种为日元，仅支持填写整数。</p>",
                              "name": "enrollCostPrice",
                              "required": true
                            }
                          }
                        ]
                      },
                      {
                        "props": {
                          "type": "object",
                          "multiple": 1,
                          "description": "<p style=\"text-align: start;\"><span style=\"font-size: 14px;\">自运营模式下，若活动详情接口返回</span><span style=\"font-size: 14px;\"><code>partakeScope=1</code></span><span style=\"font-size: 14px;\">，需通过本字段按站点提报SKU维度的活动价格。</span></p><p style=\"text-align: start;\"><span style=\"font-size: 14px;\">其中，若</span><span style=\"font-size: 14px;\"><code>supportSelectSitePartake=0</code></span><span style=\"font-size: 14px;\">，则需为</span><span style=\"font-size: 14px;\"><code>siteList</code></span><span style=\"font-size: 14px;\">中全部站点提报活动价格；若</span><span style=\"font-size: 14px;\"><code>supportSelectSitePartake=1</code></span><span style=\"font-size: 14px;\">，则可选择</span><span style=\"font-size: 14px;\"><code>siteList</code></span><span style=\"font-size: 14px;\">中的部分站点提报。</span></p>",
                          "name": "siteInfoList"
                        },
                        "children": [
