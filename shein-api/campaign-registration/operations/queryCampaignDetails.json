                              "type": "object",
                              "description": "规则列表",
                              "properties": {
                                "requirementKey": {
                                  "type": "string",
                                  "description": "规则标题"
                                },
                                "requirementDesc": {
                                  "type": "string",
                                  "description": "规则描述"
                                },
                                "isMeetRequirement": {
