                        "site": {
                          "type": "string",
                          "description": "站点，样例：shein-br"
                        },
                        "currency": {
                          "type": "string",
                          "description": "币种，样例：BRL"
                        }
                      }
                    },
                    "canPartake": {
                      "type": "integer",
                      "description": "是否可报名。0：不可报，1：可报。"
                    },
                    "cannotPartakeReason": {
                      "type": "string",
                      "description": "不可报名原因"
                    },
                    "supportSelectSitePartake": {
                      "type": "integer",
                      "description": "是否支持从所有可报站点中选择部分站点报名活动。 0：不支持，1：支持。"
                    },
                    "siteList": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "description": "可报名活动站点"
                      },
