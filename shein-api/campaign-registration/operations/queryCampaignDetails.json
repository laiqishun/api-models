                    },
                    "maxPartakeGoodsNum": {
                      "type": "integer",
                      "description": "每店铺最大提报SKC商品数量。"
                    },
                    "dependOnActivityId": {
                      "type": "integer",
                      "description": "关联报名活动ID。报名本活动的前提，要先报名关联报名活动ID。"
                    },
                    "supplyPriceCurrency": {
                      "type": "string",
                      "description": "供货价商家（即半托管、全托管模式）报价币种"
                    },
                    "sellPriceSiteInfoList": {
                      "type": "object",
                      "description": "售价商家（即自运营模式）可报站点对应币种",
