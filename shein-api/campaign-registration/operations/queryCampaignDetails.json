                      "type": "string",
                      "description": "活动名称"
                    },
                    "activityType": {
                      "type": "integer",
                      "description": "活动类型（1：频道； 2：清仓； 3：大促；4：日常）"
                    },
                    "partakeStartTime": {
                      "type": "integer",
                      "description": "报名开始时间。时间戳，单位毫秒。"
                    },
                    "partakeEndTime": {
                      "type": "integer",
                      "description": "报名结束时间。时间戳，单位毫秒。"
                    },
                    "activityStartTime": {
                      "type": "integer",
                      "description": "活动开始时间。时间戳，单位毫秒。"
                    },
                    "activityEndTime": {
                      "type": "integer",
                      "description": "活动结束时间。时间戳，单位毫秒。"
                    },
                    "activityIntroduction": {
                      "type": "string",
                      "description": "活动介绍。html格式，图片链接或文本。"
                    },
                    "storeRequirementList": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "description": "店铺规则",
                        "properties": {
                          "requirementKey": {
                            "type": "string",
                            "description": "规则标题"
                          },
                          "requirementDesc": {
                            "type": "string",
                            "description": "规则描述"
                          },
                          "isMeetRequirement": {
                            "type": "integer",
                            "description": "是否符合要求。0：不符合，1：符合。"
                          }
                        }
                      },
                      "x-shein-original-multiple": 1
                    },
                    "goodsRequirementSetList": {
                      "type": "array",
                      "items": {
                        "type": "object",
