        },
        "invoiceFileType": {
          "type": "string",
          "description": "发票文件类型,约定为\"pdf\"或者\"png\"\""
        },
        "invoiceData": {
          "type": "array",
          "items": {
            "type": "string",
            "x-aliexpress-original-type": "byte[]",
            "description": "发票文件的数据. 字节流的方式, 请注意,限制在5M以下"
          }
        },
        "invoiceDirection": {
          "type": "string",
          "description": "开票方向 （正向/逆向）invoice_direction是开票方向, 正向是\"BLUE\", 逆向是\"RED\" (正向发票，指买家下单支付 逆向发票指的是买家发生了退款，开逆向发票)"
        },
        "invoiceName": {
          "type": "string",
          "description": "发票名称"
        },
        "orderId": {
          "type": "string",
          "description": "订单id"
        },
