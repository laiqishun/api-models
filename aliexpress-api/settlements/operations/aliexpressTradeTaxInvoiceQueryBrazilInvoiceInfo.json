  "definitions": {
    "BusinessRequest": {
      "type": "object",
      "properties": {
        "trade_order_id_list": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "订单号的列表,支持批量查询,但一次查询不能超过20个元素."
          }
        },
        "source": {
          "type": "string",
          "description": "请求来源,统一填写\"ISV\""
        }
      },
      "required": [
        "trade_order_id_list",
        "source"
      ]
    },
    "BusinessResponse": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "description": "响应结果对象，包含查询返回的完整数据结构，主要包含 data（数据内容）和 pageInfo（分页信息）两个核心部分",
          "properties": {
            "data": {
              "type": "object",
              "description": "核心字段说明 1. status - 发票状态 类型：String 说明：表示发票的审核状态 示例值：\"REVIEW_SUCCESS\"（审核成功） 字段路径：dataSource[].status 2. nfeTotalValue - 发票总金额 类型：Object 说明：NFE发票的总金额，包含币种信息 示例值：amount: 128.5, currencyCode: \"BRL\"（128.5巴西雷亚尔） 字段路径：dataSource[].nfeTotalValue.amount 和 dataSource[].nfeTotalValue.currencyCode 3. invoiceNumber - 发票票号 类型：String 说明：NFE发票的票号 示例值：\"12345\" 字段路径：dataSource[].invoiceNumber 4. invoiceKey - 发票号 类型：String 说明：NFE发票的唯一标识Key（44位数字） 示例值：\"35210812345678000123550010000123451234567890\" 字段路径：dataSource[].invoiceKey 5. sender_cnpj - 发票税号（发件人） 类型：String 说明：发件人（卖家）的CNPJ税号 示例值：\"12345678000123\" 字段路径：dataSource[].extendInfo.sender_cnpj 6. sender_ie - 发件人IE号 类型：String 说明：发件人的州注册号（Inscrição Estadual） 示例值：\"123456789012\" 字段路径：dataSource[].extendInfo.sender_ie 7. recipient_cpf - 收件人税号 类型：String 说明：收件人（买家）的CPF税号 示例值：\"12345678901\" 字段路径：dataSource[].extendInfo.recipient_cpf 8. printInvoiceDate - 发票开具时间 类型：Long（时间戳） 说明：发票的打印/开具时间，Unix时间戳（毫秒） 示例值：1634567890000（对应日期：2021-10-18） 字段路径：dataSource[].printInvoiceDate"
            },
            "success": {
              "type": "boolean",
              "description": "请求是否成功的标识。true表示请求成功，false表示请求失败"
            },
            "error_code": {
              "type": "string",
              "description": "错误码。当请求失败时返回具体的错误类型标识"
            },
            "error": {
              "type": "string",
              "description": "错误信息。当请求失败时返回详细的错误描述信息"
            }
          },
          "required": [
            "data",
            "success",
            "error_code",
            "error"
          ]
        }
      },
      "required": [
        "result"
      ]
    }
