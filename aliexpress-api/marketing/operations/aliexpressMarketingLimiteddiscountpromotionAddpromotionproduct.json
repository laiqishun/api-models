  "definitions": {
    "BusinessRequest": {
      "type": "object",
      "properties": {
        "limited_disc_product_input_dto": {
          "type": "object",
          "description": "详细参考如下",
          "properties": {
            "exist_store_fans_discount": {
              "type": "string",
              "description": "已存在的粉丝折扣 默认为0"
            },
            "product_objects": {
              "type": "array",
              "items": {
                "type": "object",
                "description": "活动商品对象列表",
                "properties": {
                  "buy_max_num": {
                    "type": "number",
                    "description": "每人限购数量(每人最多购买数量)"
                  },
                  "product_discount_list": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "description": "活动商品优惠信息",
                      "properties": {
                        "discount": {
                          "type": "number",
                          "description": "折扣"
                        },
                        "terminal": {
                          "type": "string",
                          "description": "终端 MOBILE or ALL"
                        }
                      },
                      "required": [
                        "terminal"
                      ]
                    }
                  },
                  "product_id": {
                    "type": "number",
                    "description": "商品id"
                  },
                  "sku_inventory_list": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "description": "商品sku信息",
                      "properties": {
                        "quantity": {
                          "type": "number",
                          "description": "限时限量更改为共享库存，当前该字段仅当部分sku不参加活动时设置为0"
                        },
                        "sku_attr": {
                          "type": "string",
                          "description": "sku属性"
                        }
                      }
                    }
                  },
                  "used_warehouse": {
                    "type": "boolean",
                    "description": "废弃：全局都是共享库存，废弃该字段，即使设置也不生效"
                  }
                },
                "required": [
                  "product_id"
                ]
              }
            },
            "promotion_id": {
              "type": "number",
              "description": "活动id"
            },
            "store_club_discount_rate": {
              "type": "string",
              "description": "粉丝折扣,与exist_store_fans_discount不同值时，才会更新粉丝折扣"
            }
          },
          "required": [
            "product_objects",
            "promotion_id"
          ]
        }
      }
    },
