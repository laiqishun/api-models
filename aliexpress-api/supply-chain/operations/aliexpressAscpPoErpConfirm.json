  "definitions": {
    "BusinessRequest": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "description": "渠道（可以在这个API中查询：global.seller.relation.query）， 海外托管必填"
        },
        "channel_user_id": {
          "type": "number",
          "description": "渠道seller id （可以在这个API中查询：global.seller.relation.query）， 请使用 business_type = ONE_STOP_SERVICE 的全托管店铺 channel_seller_id"
        },
        "merchant_code": {
          "type": "string",
          "description": "经营组织 {全托管:AECHOICE；半托管：AEFF；海外托管：AETK}"
        },
        "purchase_order_no": {
          "type": "string",
          "description": "备货单号"
        },
        "gmt_pre_delivery": {
          "type": "string",
          "description": "预计发货时间 {yyyy-MM-dd}。 时间可选范围：[当天，最晚到仓时间]，可以等于"
        },
        "all_quantity_confirm": {
          "type": "boolean",
          "description": "确认数量是否等于采购单采购数量{true/false}。 [true: 供应商确认数量=采购单数量] [false: 供应商确认数量!=采购数量，则字段{sc_item_id, confirm_quantity}必填。]"
        },
        "reason": {
          "type": "string",
          "description": "供应商确认不能按照采购单采购数量备货原因。 当all_quantity_confirm == false  && confirm_quantity != 采购单备货数量时，必填。 当填写的code不再下列枚举中时，系统无法识别:阻断异常。 {产能不足 未按箱规下单 备货量偏高 销量预测偏高 库存水位偏高 目的仓不可售 仓产能问题 其他}"
        },
        "purchase_confirm_item_list": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "demo",
            "properties": {
              "sc_item_id": {
                "type": "number",
                "description": "货品id。 all_quantity_confirm == false时，必填。"
              },
              "confirm_quantity": {
                "type": "number",
                "description": "对应货品供应商确认数量。 all_quantity_confirm == false时，必填。"
              }
            }
          }
        }
      },
      "required": [
        "merchant_code",
        "purchase_order_no",
        "all_quantity_confirm"
      ]
    },
    "BusinessResponse": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "description": "demo",
          "properties": {
            "data": {
              "type": "object",
              "description": "demo",
              "properties": {
                "status": {
                  "type": "string",
                  "description": "success"
                }
              }
            },
            "success": {
              "type": "boolean",
              "description": "是否成功"
            },
            "error_code": {
              "type": "string",
              "description": "错误码"
            },
            "error_msg": {
              "type": "string",
              "description": "描述"
            }
          }
        }
      }
    }
  },
