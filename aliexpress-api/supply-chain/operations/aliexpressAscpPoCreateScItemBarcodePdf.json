  "definitions": {
    "BusinessRequest": {
      "type": "object",
      "properties": {
        "param0": {
          "type": "object",
          "description": "略",
          "properties": {
            "channel_user_id": {
              "type": "number",
              "description": "渠道seller id （可以在这个API中查询：global.seller.relation.query）"
            },
            "pdf_size": {
              "type": "string",
              "description": "全托管和半托管支持尺寸（必填）: 1. SIZE_60_30: 60mm*30mm；2. SIZE_60_60: 60mm*60mm；3. SIZE_60_90: 60mm*90mm；4. SIZE_60_120: 60mm*120mm；5. SIZE_100_100: 100mm*100mm；4. SIZE_100_150: 100mm*150mm；"
            },
            "tag_types": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "1、如果tag_types为空或者为[GOODS, GOODS_CATEGORY]，会打印条形码标签和品类合规标签，如果该货品没有品类合规标签，那么只会打印条形码标签；2、如果tag_types为[GOODS]，只会打印条形码标签。3、如果tag_types为[GOODS_CATEGORY]，只会品类合规标签。"
              }
            },
            "show_divider_page": {
              "type": "string",
              "description": "默认为false，仓发场景可指定true，那么会安装货品维度打印分隔页；JIT场景请不要传。"
            },
            "goods_infos": {
              "type": "array",
              "items": {
                "type": "object",
                "description": "货品信息list",
                "properties": {
                  "sc_item_id": {
                    "type": "number",
                    "description": "货品id"
                  },
                  "production_date": {
                    "type": "string",
                    "description": "生产年月"
                  }
                }
              }
            },
            "channel": {
              "type": "string",
              "description": "渠道（可以在这个API中查询：global.seller.relation.query）， 海外托管必填"
            },
            "purchase_order_no": {
              "type": "string",
              "description": "采购单号"
            },
            "biz_type": {
              "type": "number",
              "description": "全托管请填写5110000，半托管请填写7668000，choice2.0(AEG)请填写288000 海外托管请填写10040000"
            }
          },
          "required": [
            "channel_user_id",
            "pdf_size",
            "purchase_order_no",
            "biz_type"
          ]
        }
      },
      "required": [
        "param0"
      ]
    },
    "BusinessResponse": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "description": "接口出参",
          "properties": {
            "data": {
              "type": "string",
              "description": "接口调用成功时返回pdf地址，失败是为空"
            },
            "success": {
              "type": "boolean",
              "description": "接口调用是否成功"
            },
            "error_code": {
              "type": "string",
              "description": "错误编码"
            },
            "error_msg": {
              "type": "string",
              "description": "错误描述"
            },
            "cn_id": {
              "type": "string",
              "description": "店铺loginId"
            }
          },
          "required": [
            "data",
            "success",
            "error_code",
            "error_msg"
          ]
        }
      },
      "required": [
        "result"
      ]
    }
  },
