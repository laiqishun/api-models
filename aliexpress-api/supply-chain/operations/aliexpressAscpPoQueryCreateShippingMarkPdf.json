  "definitions": {
    "BusinessRequest": {
      "type": "object",
      "properties": {
        "param0": {
          "type": "object",
          "description": "[全托管-仓发模式，必填参数: (merchant_code, channel_user_id, consign_order_no, pdf_size, box_number)][JIT模式，需要使用(purchase_order_no)]",
          "properties": {
            "purchase_order_no": {
              "type": "string",
              "description": "采购单号。[指定「采购单号」打印时，仅支持: JIT 模式](采购单号/发货单号，必填，且只能指定一个)"
            },
            "biz_type": {
              "type": "number",
              "description": "全托管请填写5110000，半托管请填写7668000，choice2.0(AEG)请填写288000，海托10040000"
            },
            "box_number": {
              "type": "number",
              "description": "送仓箱数"
            },
            "channel_user_id": {
              "type": "number",
              "description": "渠道seller id （可以在这个API中查询：global.seller.relation.query）"
            },
            "pdf_size": {
              "type": "string",
              "description": "打印的箱唛尺寸。[JIT：仅支持SIZE_100_150(100mm*150mm)、SIZE_100_100(100mm*100mm)、SIZE_60_30(60mm*30mm)、SIZE_60_60(60mm*60mm)，如果不填，默认SIZE_100_150],[全托管-仓发：SIZE_100_100,SIZE_A4,SIZE_A4_MARK(只打印唛头), SIZE_A4_ITEM(只打印货品清单), 必填]"
            },
            "print_barcode": {
              "type": "boolean",
              "description": "是否混打（混打是指箱唛、货品标签、品类标签一起打印，当前支持SIZE_100_150(100mm*150mm)、SIZE_100_100(100mm*100mm)、SIZE_60_30(60mm*30mm)、SIZE_60_60(60mm*60mm)四个尺寸） ：1、如果为true，且additional_tag_types为空或【\"GOODS\", \"GOODS_CATEGORY\"】，会同时打印箱唛、条形码标签和品类合规标签（前提是有品类合规标签） 2、如果为true，且additional_tag_types为【\"GOODS\"】，会打印箱唛，条形码标签 3、如果为true，且additional_tag_types为【\"GOODS_CATEGORY\"】，会打印箱唛，品类合规标签4、如果为false，只打印箱唛，不打印条形码标签和品类合规标签，此情况下则不看additional_tag_types的取值"
            },
            "additional_tag_types": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "指定全、半托管的货品标签类型，数组，可选值有条形码标签GOODS、品类合规标签GOODS_CATEGORY，可用的组合有: 1. [GOODS, GOODS_CATEGORY]; 2. [GOODS];3[GOODS_CATEGORY]"
              }
            },
            "consign_order_no": {
              "type": "string",
              "description": "发货单号。[指定「发货单号」打印时，仅支持: 全托管-仓发模式使用](采购单号/发货单号，必填，且只能指定一个。)"
            },
            "channel": {
              "type": "string",
              "description": "渠道（可以在这个API中查询：global.seller.relation.query）， 海外托管必填"
            },
            "async": {
              "type": "boolean",
              "description": "是否异步，如果异步则返回任务id，需要接受异步结果回告，不传或者false则正常返回文件url"
            }
          },
          "required": [
            "biz_type",
            "channel_user_id"
          ]
        }
      }
    },
    "BusinessResponse": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "description": "接口出参",
          "properties": {
            "data": {
              "type": "string",
              "description": "接口调用成功时返回 pdf地址，失败是为空"
            },
            "success": {
              "type": "boolean",
              "description": "接口调用是否成功."
            },
            "error_code": {
              "type": "string",
              "description": "错误编码."
            },
            "error_msg": {
              "type": "string",
              "description": "错误描述."
            }
          },
          "required": [
            "data",
            "success",
            "error_code",
            "error_msg"
          ]
        }
      },
      "required": [
        "result"
      ]
    }
  },
