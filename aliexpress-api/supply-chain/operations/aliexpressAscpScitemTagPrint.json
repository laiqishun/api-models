  "definitions": {
    "BusinessRequest": {
      "type": "object",
      "properties": {
        "sc_item_id": {
          "type": "number",
          "description": "货品id"
        },
        "include_sign_tag_info": {
          "type": "boolean",
          "description": "是否包含品类标签信息"
        },
        "seller_id": {
          "type": "number",
          "description": "渠道seller id （可以在这个API中查询：global.seller.relation.query）"
        },
        "merchant_code": {
          "type": "string",
          "description": "商家编码(租户id) AEFF或者AECHOICE"
        },
        "print_template_size": {
          "type": "string",
          "description": "打印模板尺寸  入参值：60_60 or 60_30"
        },
        "replica_count": {
          "type": "number",
          "description": "重复次数"
        },
        "feature_map": {
          "type": "object",
          "description": "扩展字段。支持KEY：include_base_tag_info，是否包含基础信息，boolean类型。作用解释：当外层include_sign_tag_info=true并且include_base_tag_info=false时只打印品类标签信息"
        },
        "production_date": {
          "type": "string",
          "description": "生产年月"
        },
        "scene_list": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "打印的场景 1-货品基本数据，2-品类标签，3-bbc标签，如果三个标签都需要打印，填[1,2,3],这个数据有值，上面的include_sign_tag_info将失效"
          }
        }
      },
      "required": [
        "sc_item_id",
        "seller_id",
        "merchant_code",
        "print_template_size",
        "replica_count"
      ]
    },
