  "definitions": {
    "BusinessRequest": {
      "type": "object",
      "properties": {
        "purchase_order_create_request": {
          "type": "object",
          "description": "入库单创建DTO，存在主子店铺关系时，请登录主店铺",
          "properties": {
            "merchant_code": {
              "type": "string",
              "description": "业务租户编码，AEG场景请填写AEGDCHAIN"
            },
            "eta": {
              "type": "number",
              "description": "期望上架日期时间戳,单位ms。精度到天即可，更高精度仍然以天为准"
            },
            "biz_type": {
              "type": "number",
              "description": "业务租户Id，AEG场景请填写288000"
            },
            "delivery_type": {
              "type": "number",
              "description": "1：快递；2：卡车派送"
            },
            "remark": {
              "type": "string",
              "description": "入库单备注"
            },
            "inbound_wave": {
              "type": "number",
              "description": "1：上午；2：下午"
            },
            "request_no": {
              "type": "string",
              "description": "长度不得超过25位，建单请求外部单号，同一个主店铺下需全局唯一，重复时幂等返回之前创建成功的入库单号。建议使用 仓_时间戳 保证全局唯一"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "description": "入库单创建明细，品+计划入库数量",
                "properties": {
                  "quantity": {
                    "type": "number",
                    "description": "计划入库数量"
                  },
                  "sc_item_id": {
                    "type": "number",
                    "description": "货品id"
                  }
                },
                "required": [
                  "quantity",
                  "sc_item_id"
                ]
              }
            },
            "store_code": {
              "type": "string",
              "description": "仓编码"
            }
          },
          "required": [
            "merchant_code",
            "eta",
            "biz_type",
            "delivery_type",
            "inbound_wave",
            "request_no",
            "items",
            "store_code"
          ]
        }
      },
      "required": [
        "purchase_order_create_request"
      ]
    },
    "BusinessResponse": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "description": "接口出参",
          "properties": {
            "data": {
              "type": "object",
              "description": "接口调用成功时返回入库单号，失败是为空"
            },
            "success": {
              "type": "boolean",
              "description": "接口调用是否成功"
            },
            "error_code": {
              "type": "string",
              "description": "错误编码"
            },
            "request_no": {
              "type": "string",
              "description": "入参中的请求外部单号，用于错误排查"
            },
            "error_msg": {
              "type": "string",
              "description": "错误描述"
            }
          },
          "required": [
            "data",
            "success",
            "error_code",
            "request_no",
            "error_msg"
          ]
        }
      },
      "required": [
        "result"
      ]
    }
  },
