                      "type": "string",
                      "description": "仓库名称"
                    },
                    "sellable_quantity": {
                      "type": "number",
                      "description": "库存，编辑库存只能增加，不能减少"
                    },
                    "warehouse_code": {
                      "type": "string",
                      "description": "仓库编码"
                    }
                  },
                  "required": [
                    "warehouse_type",
                    "warehouse_name",
                    "sellable_quantity",
                    "warehouse_code"
