  "definitions": {
    "BusinessRequest": {
      "type": "object",
      "properties": {
        "channel_seller_id": {
          "type": "number",
          "description": "渠道seller id （可以在这个API中查询：global.seller.relation.query）， 请使用 business_type = LOCAL_SERVICE 的全托管店铺 channel_seller_id"
        },
        "product_sku_stock_list": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "商品sku库存列表",
            "properties": {
              "sku_warehouse_stock_list": {
                "type": "array",
                "items": {
                  "type": "object",
                  "description": "sku不同仓 对应库存列表",
                  "properties": {
                    "warehouse_type": {
                      "type": "string",
                      "description": "仓库类型， 只有类型 =dropshipping 的仓才能编辑库存"
                    },
                    "sellable_quantity": {
                      "type": "number",
                      "description": "库存数量"
                    },
                    "warehouse_code": {
                      "type": "string",
                      "description": "仓库编码dropshipping 的仓才能编辑库存"
                    }
                  },
                  "required": [
                    "warehouse_type",
                    "sellable_quantity",
                    "warehouse_code"
                  ]
                }
              },
              "sku_id": {
                "type": "number",
                "description": "sku唯一标识，可以通过这个接口获取：aliexpress.local.service.products.list"
              }
            },
            "required": [
              "sku_warehouse_stock_list",
              "sku_id"
            ]
          }
        },
        "product_id": {
          "type": "number",
          "description": "商品id"
        },
        "channel": {
          "type": "string",
          "description": "渠道（可以在这个API中查询：global.seller.relation.query）"
        }
      },
      "required": [
        "channel_seller_id",
        "product_sku_stock_list",
        "product_id",
        "channel"
      ]
    },
    "BusinessResponse": {
      "type": "object",
      "properties": {
        "product_sku_stock_list": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "sku列表",
            "properties": {
              "sku_warehouse_stock_list": {
                "type": "array",
                "items": {
                  "type": "object",
                  "description": "单sku仓库下列表",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "单个sku单个仓库下是否成功"
                    },
                    "error_message": {
                      "type": "string",
                      "description": "具体仓库下库存更新的错误说明"
                    },
                    "error_code": {
                      "type": "string",
                      "description": "具体仓库下库存更新的错误码"
                    },
                    "warehouse_code": {
                      "type": "string",
                      "description": "仓库编码"
                    }
                  },
                  "required": [
                    "success",
                    "error_message",
                    "error_code",
                    "warehouse_code"
                  ]
                }
              },
              "sku_id": {
                "type": "string",
                "description": "sku id"
              }
            },
            "required": [
              "sku_warehouse_stock_list",
              "sku_id"
            ]
          }
        },
        "product_id": {
          "type": "number",
          "description": "商品id"
        },
        "success": {
          "type": "string",
          "description": "当所有仓库库存均更新成功时为true,其他情况表示部分失败，开发者需解析sku_warehouse_stock_list获取具体成功和失败的仓库列表及原因"
        },
        "error_message": {
          "type": "string",
          "description": "错误信息"
        },
        "error_code": {
          "type": "string",
          "description": "错误码"
        }
      },
      "required": [
        "product_sku_stock_list",
        "product_id",
        "success",
        "error_message",
        "error_code"
      ]
    }
  },
