  "definitions": {
    "BusinessRequest": {
      "type": "object",
      "properties": {
        "channel_seller_id": {
          "type": "number",
          "description": "渠道seller id （可以在这个API中查询：global.seller.relation.query）， 请使用 business_type = LOCAL_SERVICE 的全托管店铺 channel_seller_id"
        },
        "sku_price_model_list": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "商品sku供货价列表",
            "properties": {
              "sku_id": {
                "type": "number",
                "description": "skuId"
              },
              "supply_price": {
                "type": "string",
                "description": "sku供货价，必须设置"
              },
              "dim_supply_price_list": {
                "type": "array",
                "items": {
                  "type": "object",
                  "description": "分目的国家供货价列表，如果发品的时候设置了分目的国供货价，则可以通过该参数对目的国供货价进行修改，如果商品没有设置，无法通过该接口新增或修改分目的国供货价",
                  "properties": {
                    "country_code": {
                      "type": "string",
                      "description": "国家代码，KR，ES,FR,IT,PL.,DE,NL等"
                    },
                    "country_supply_price": {
                      "type": "string",
                      "description": "对应国家的供货价"
                    },
                    "country_goods_value": {
                      "type": "string",
                      "description": "分目的国供货价的货值"
                    },
                    "country_logistic_value": {
                      "type": "string",
                      "description": "分目的国供货价的物流费"
                    }
                  },
                  "required": [
                    "country_code",
                    "country_supply_price"
                  ]
                }
              },
              "glo_goods_value": {
                "type": "string",
                "description": "glo供货价的货值"
              },
              "glo_logistic_value": {
                "type": "string",
                "description": "glo供货价物流费"
              }
            },
            "required": [
              "sku_id",
              "supply_price"
            ]
          }
        },
        "product_id": {
          "type": "number",
          "description": "商品id"
        },
        "channel": {
          "type": "string",
          "description": "渠道（可以在这个API中查询：global.seller.relation.query）"
        }
      },
      "required": [
        "channel_seller_id",
        "sku_price_model_list",
        "product_id",
        "channel"
      ]
    },
    "BusinessResponse": {
      "type": "object",
      "properties": {
        "product_id": {
          "type": "number",
          "description": "商品id"
        },
        "success": {
          "type": "string",
          "description": "是否成功，注意请求成功会进入审核流程，审核通过之后供货价才会生效"
        },
        "error_message": {
          "type": "string",
          "description": "错误信息"
        },
        "error_code": {
          "type": "string",
          "description": "错误码"
        }
      },
      "required": [
        "product_id",
        "success",
        "error_message",
        "error_code"
      ]
    }
  },
