  "definitions": {
    "BusinessRequest": {
      "type": "object",
      "properties": {
        "channel_seller_id": {
          "type": "number",
          "description": "渠道seller id （可以在这个API中查询：global.seller.relation.query）， 请使用 business_type = ONE_STOP_SERVICE 的全托管店铺 channel_seller_id"
        },
        "product_id": {
          "type": "number",
          "description": "商品id"
        },
        "channel": {
          "type": "string",
          "description": "渠道（可以在这个API中查询：global.seller.relation.query）"
        }
      },
      "required": [
        "channel_seller_id",
        "product_id",
        "channel"
      ]
    },
    "BusinessResponse": {
      "type": "object",
      "properties": {
        "product_sku_stock_list": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "商品sku库存列表",
            "properties": {
              "sku_warehouse_stock_list": {
                "type": "array",
                "items": {
                  "type": "object",
                  "description": "sku不同仓 对应库存列表",
                  "properties": {
                    "warehouse_type": {
                      "type": "string",
                      "description": "仓库类型， 只有类型 =dropshipping的仓才能编辑库存"
                    },
                    "warehouse_name": {
                      "type": "string",
                      "description": "仓库名称"
                    },
                    "sellable_quantity": {
                      "type": "number",
                      "description": "库存"
                    },
                    "warehouse_code": {
                      "type": "string",
                      "description": "仓库编码"
                    },
                    "can_change_quantity": {
                      "type": "boolean",
                      "description": "卖家是否可以编辑库存。true 可以，false 不可以"
                    },
                    "can_increase_quantity": {
                      "type": "boolean",
                      "description": "是否可增加库存"
                    },
                    "can_decrease_quantity": {
                      "type": "boolean",
                      "description": "是否可减少库存"
                    }
                  },
                  "required": [
                    "warehouse_type",
                    "warehouse_name",
                    "sellable_quantity",
                    "warehouse_code"
                  ]
                }
              },
              "sku_id": {
                "type": "number",
                "description": "sku唯一标识"
              }
            },
            "required": [
              "sku_warehouse_stock_list",
              "sku_id"
            ]
          }
        },
        "success": {
          "type": "boolean",
          "description": "请求结果：成功，失败"
        }
      },
      "required": [
        "product_sku_stock_list",
        "success"
      ]
    }
