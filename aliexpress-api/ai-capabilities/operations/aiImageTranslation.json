          "type": "string",
          "description": "唯一键用来排查问题"
        },
        "success": {
          "type": "boolean",
          "description": "是否成功"
        },
        "resMessage": {
          "type": "string",
          "description": "返回消息"
        }
      },
      "required": [
        "resCode",
        "data",
        "requestId",
        "success",
        "resMessage"
      ]
