  "definitions": {
    "BusinessRequest": {
      "type": "object",
      "properties": {
        "imageUrl": {
          "type": "string",
          "description": "原图 URL"
        },
        "sourceLanguage": {
          "type": "string",
          "description": "源语种：英(en)、中(zh)、土耳其语(tr)"
        },
        "targetLanguage": {
          "type": "string",
          "description": "目标语种：英(en)、西(es)、法(fr)、葡(pt)、韩(ko)、日(ja)、俄(ru)、繁体(zh-tw)、越南语(vi)、阿拉伯语(ar)、希伯来语(he)"
        },
        "translatingTextInTheProduct": {
          "type": "boolean",
          "description": "是否翻译商品主体上文字（false=不翻译商品主体上文字（默认），true=翻译商品主体上文字）"
        },
        "useImageEditor": {
          "type": "boolean"
        },
        "translatingBrandInTheProduct": {
          "type": "boolean",
          "description": "是否翻译品牌上文字（false=不翻译（默认），true=翻译）"
        }
      },
      "required": [
        "imageUrl",
        "sourceLanguage",
        "targetLanguage"
      ]
    },
