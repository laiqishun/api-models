  "definitions": {
    "BusinessRequest": {
      "type": "object",
      "properties": {
        "text": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "待翻译文本；总字符长度不超过 50000，List 不超过 50 条。"
          }
        },
        "sourceLanguage": {
          "type": "string",
          "description": "源语言代码；使用 ISO 693-1 语言代码规范，例如“英文”的语言代码为 “en”，中文的语言代码为“zh”。支持的语向见如下支持语向列表。"
        },
        "targetLanguage": {
          "type": "string",
          "description": "目标语言代码；使用 ISO 693-1 语言代码规范，请选择如下支持的翻译语向入参；当前支持的翻译语向列表（源语言-目标语言)：中(zh)→英(en)；中(zh)/英(en)→乌尔都语(ur)/孟加拉语(bn)/乌克兰语(uk)/波兰语(pl)/俄语(ru)/法语(fr)/西语(es)/葡语(pt)/韩语(ko)/意大利语(it)/阿拉伯语(ar)/德语(de)/土耳其语(tr)/日语(ja)/希伯来语(he)/印尼语(id)/马来语(ms)/荷兰语(nl)/泰语(th)/越南语(vi)；土耳其语(tr)→阿拉伯语(ar)/英语(en)/德语(de)/罗马尼亚语(ro)/希腊语(el)/匈牙利语(hu)/捷克语(cs)"
        },
        "formatType": {
          "type": "string",
          "description": "源文本的格式类型；支持 text/html 类型。"
        },
        "glossary": {
          "type": "string",
          "description": "干预词表 ID，干预词表需要单独创建后在入参中提供干预词表的 ID，支持传入多个干预词表。如果传入的干预词表 ID 为空，则不对翻译结果进行干预。"
        }
      },
      "required": [
        "text",
        "targetLanguage"
      ]
    },
    "BusinessResponse": {
      "type": "object",
      "properties": {
        "resCode": {
          "type": "number",
          "description": "响应代码； 200 代表调用成功，其他的响应代码可以参考错误码信息。"
        },
        "data": {
          "type": "object",
          "description": "返回的翻译结果结构体信息。"
        },
        "requestId": {
          "type": "string",
          "description": "请求 ID；用来识别唯一一次请求调用。"
        },
        "success": {
          "type": "boolean",
          "description": "是否成功；true 代表成功，false 代表失败。"
        },
        "resMessage": {
          "type": "string",
          "description": "报错信息，例如\"content has sensitive data, please try other input\"。"
        }
      },
      "required": [
        "resCode",
        "data",
        "requestId",
        "success",
        "resMessage"
      ]
    }
  },
