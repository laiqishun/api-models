  "definitions": {
    "BusinessRequest": {
      "type": "object",
      "properties": {
        "video_name": {
          "type": "string",
          "description": "自定义视频名称"
        },
        "origin_video_url": {
          "type": "string",
          "description": "待转存视频文件URL"
        },
        "biz_id": {
          "type": "string",
          "description": "自定义业务id，如商品id。视频异步上传处理完成后，将原样返回给ISV"
        }
      },
      "required": [
        "video_name",
        "origin_video_url",
        "biz_id"
      ]
    },
    "BusinessResponse": {
      "type": "object",
      "properties": {
        "result": {
          "type": "object",
          "description": "返回结果",
          "properties": {
            "data": {
              "type": "object",
              "description": "视频转存结果",
              "properties": {
                "transfer_status": {
                  "type": "number",
                  "description": "0表示转存成功，1表示转存失败，2表示处理中。同一个URL首次上传时，返回2"
                },
                "biz_id": {
                  "type": "string",
                  "description": "入参中的bizId，原样返回"
                },
                "video_info": {
                  "type": "object",
                  "description": "视频信息。transferStatus!=0时为空",
                  "properties": {
                    "id": {
                      "type": "number",
                      "description": "媒体中心视频id。用于管理媒体中心的视频文件"
                    },
                    "store_name": {
                      "type": "string",
                      "description": "视频存储id。 需要等视频审核通过才能发品。 视频审核状态请监听消息推送或者调用视频查询接口：global.mediacenter.video.getbystoragename"
                    },
                    "name": {
                      "type": "string",
                      "description": "自定义视频名称。等于入参中的videoName"
                    },
                    "file_format": {
                      "type": "string",
                      "description": "视频文件格式"
                    },
                    "size": {
                      "type": "number",
                      "description": "视频文件大小，单位byte"
                    },
                    "cover_url": {
                      "type": "string",
                      "description": "视频封面图片URL"
                    },
                    "duration": {
                      "type": "number",
                      "description": "视频时长，单位秒"
                    },
                    "ratio": {
                      "type": "string",
                      "description": "视频宽高比"
                    },
                    "url": {
                      "type": "string",
                      "description": "视频播放地址"
                    }
                  }
                },
                "error_msg": {
                  "type": "string",
                  "description": "transfer_status=1转存失败时，此字段将给出错误原因"
                }
              }
            },
            "success": {
              "type": "boolean",
              "description": "调用是否成功"
            },
            "error_message": {
              "type": "string",
              "description": "错误信息"
            },
            "error_code": {
              "type": "string",
              "description": "错误码"
            }
          }
        }
      }
